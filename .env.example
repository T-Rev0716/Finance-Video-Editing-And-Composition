# Copy this file to .env (or use the Settings page in the app, which writes .env for you).
# Never commit .env - it is in .gitignore.

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
# Optional: without it the app uses FRED's public CSV download, which has the same numbers
# but no upcoming-release dates.
FRED_API_KEY=

# Used ONLY for wording (outline bullets, titles, B-roll prompts). Leave blank to use the
# built-in templates instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: raises the BLS daily request limit. https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# SEC asks automated tools to identify themselves, e.g. "Your Name your@email.com".
SEC_CONTACT=

# dark or light
CHART_THEME=dark
